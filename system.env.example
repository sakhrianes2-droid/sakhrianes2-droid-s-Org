# ===================================================
# Macro Intelligence Platform (Macro Intel) - Backend Environment
# All secret, unique, and administrative keys run STRICTLY here on the backend.
# ===================================================

# Groq Cloud API Key (LLM quantitative reasoning & NLP policy parsing)
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Finnhub API Key (Institutional economic calendar indicators)
# Get a free key from: https://finnhub.io/
FINNHUB_API_KEY=your_finnhub_api_key_here

# Supabase Backend Configuration (Admin & JWT verification)
# Get from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Unified Gateway Network Configuration
PORT=8000
HOST=0.0.0.0

# LLM Reasoning Model Configuration
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TEMPERATURE=0.1

# AI Inference & Resource Overhead Controls
# Set to 'false' to prevent continuous background Groq API calls (biases will be generated on-demand only)
ENABLE_BACKGROUND_AI_SYNC=true

# Cache TTL for generated asset biases in minutes (avoids re-calling Groq on restarts if recent data exists)
BIAS_CACHE_TTL_MINUTES=120

# RSS feed polling interval in seconds
RSS_POLL_INTERVAL_SECONDS=300
